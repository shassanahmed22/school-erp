generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String        @id @default(uuid()) @db.Uuid
  firstName            String        @map("first_name")
  lastName             String        @map("last_name")
  email                String        @unique
  phone                String?
  passwordHash         String        @map("password_hash")
  avatarUrl            String?       @map("avatar_url")
  status               UserStatus    @default(PENDING)
  preferredLanguage    String        @default("en") @map("preferred_language")
  preferredTheme       String        @default("light") @map("preferred_theme")
  emailVerifiedAt      DateTime?     @map("email_verified_at")
  lastLoginAt          DateTime?     @map("last_login_at")
  lastLoginIp          String?       @map("last_login_ip")
  passwordResetToken   String?       @map("password_reset_token")
  passwordResetExpires DateTime?     @map("password_reset_expires")
  rememberToken        String?       @map("remember_token")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  deletedAt            DateTime?     @map("deleted_at")
  createdById          String?       @map("created_by_id") @db.Uuid
  activityLogs         ActivityLog[]
  auditLogs            AuditLog[]
  studentProfile       Student?
  teacherProfile       Teacher?
  userRoles            UserRole[]
  createdBy            User?         @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers         User[]        @relation("UserCreatedBy")

  @@index([email])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  slug            String           @unique
  description     String?
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([slug])
  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  module          String
  action          String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  rolePermissions RolePermission[]

  @@index([module])
  @@index([name])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  action     AuditAction
  entityType String?     @map("entity_type")
  entityId   String?     @map("entity_id") @db.Uuid
  oldValues  Json?       @map("old_values")
  newValues  Json?       @map("new_values")
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")
  user       User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ActivityLog {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String?      @map("user_id") @db.Uuid
  type        ActivityType
  description String
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at")
  user        User?        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("activity_logs")
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  group     String   @default("general")
  type      String   @default("string")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([group])
  @@map("settings")
}

model Language {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  name       String
  nativeName String   @map("native_name")
  direction  String   @default("ltr")
  isActive   Boolean  @default(true) @map("is_active")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("languages")
}

model AcademicYear {
  id          String              @id @default(uuid()) @db.Uuid
  name        String              @unique
  startDate   DateTime            @map("start_date")
  endDate     DateTime            @map("end_date")
  isCurrent   Boolean             @default(false) @map("is_current")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  deletedAt   DateTime?           @map("deleted_at")
  classes     Class[]
  enrollments StudentEnrollment[]

  @@index([isCurrent])
  @@map("academic_years")
}

model Class {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  numericGrade   Int            @map("numeric_grade")
  academicYearId String         @map("academic_year_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")
  classSubjects  ClassSubject[]
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  sections       Section[]

  @@unique([name, academicYearId])
  @@index([academicYearId])
  @@map("classes")
}

model Section {
  id           String              @id @default(uuid()) @db.Uuid
  name         String
  classId      String              @map("class_id") @db.Uuid
  capacity     Int                 @default(40)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  deletedAt    DateTime?           @map("deleted_at")
  classTeacher ClassTeacher?
  class        Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments  StudentEnrollment[]

  @@unique([name, classId])
  @@index([classId])
  @@map("sections")
}

model ClassTeacher {
  id         String   @id @default(uuid()) @db.Uuid
  sectionId  String   @unique @map("section_id") @db.Uuid
  teacherId  String   @map("teacher_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  section    Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("class_teachers")
}

model Subject {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  code            String           @unique
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  classSubjects   ClassSubject[]
  teacherSubjects TeacherSubject[]

  @@index([code])
  @@map("subjects")
}

model ClassSubject {
  id              String           @id @default(uuid()) @db.Uuid
  classId         String           @map("class_id") @db.Uuid
  subjectId       String           @map("subject_id") @db.Uuid
  isElective      Boolean          @default(false) @map("is_elective")
  createdAt       DateTime         @default(now()) @map("created_at")
  class           Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject         Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherSubjects TeacherSubject[]

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
  @@map("class_subjects")
}

model TeacherSubject {
  id             String        @id @default(uuid()) @db.Uuid
  teacherId      String        @map("teacher_id") @db.Uuid
  subjectId      String        @map("subject_id") @db.Uuid
  classSubjectId String?       @map("class_subject_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  classSubject   ClassSubject? @relation(fields: [classSubjectId], references: [id])
  subject        Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher        Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, classSubjectId])
  @@index([teacherId])
  @@index([subjectId])
  @@map("teacher_subjects")
}

model Student {
  id                 String              @id @default(uuid()) @db.Uuid
  registrationNumber String              @unique @map("registration_number")
  userId             String?             @unique @map("user_id") @db.Uuid
  admissionDate      DateTime            @default(now()) @map("admission_date")
  status             StudentStatus       @default(ACTIVE)
  firstName          String              @map("first_name")
  lastName           String              @map("last_name")
  email              String?
  phone              String?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")
  createdById        String?             @map("created_by_id") @db.Uuid
  guardians          Guardian[]
  documents          StudentDocument[]
  enrollments        StudentEnrollment[]
  history            StudentHistory[]
  profile            StudentProfile?
  user               User?               @relation(fields: [userId], references: [id])

  @@index([registrationNumber])
  @@index([status])
  @@index([lastName, firstName])
  @@index([deletedAt])
  @@map("students")
}

model StudentProfile {
  id                       String      @id @default(uuid()) @db.Uuid
  studentId                String      @unique @map("student_id") @db.Uuid
  dateOfBirth              DateTime?   @map("date_of_birth")
  gender                   Gender?
  bloodGroup               BloodGroup? @map("blood_group")
  nationality              String?
  religion                 String?
  address                  String?
  city                     String?
  photoUrl                 String?     @map("photo_url")
  emergencyContactName     String?     @map("emergency_contact_name")
  emergencyContactPhone    String?     @map("emergency_contact_phone")
  emergencyContactRelation String?     @map("emergency_contact_relation")
  previousSchoolName       String?     @map("previous_school_name")
  previousSchoolAddress    String?     @map("previous_school_address")
  previousGrade            String?     @map("previous_grade")
  medicalNotes             String?     @map("medical_notes")
  createdAt                DateTime    @default(now()) @map("created_at")
  updatedAt                DateTime    @updatedAt @map("updated_at")
  student                  Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model Guardian {
  id         String           @id @default(uuid()) @db.Uuid
  studentId  String           @map("student_id") @db.Uuid
  relation   GuardianRelation
  firstName  String           @map("first_name")
  lastName   String           @map("last_name")
  phone      String
  email      String?
  occupation String?
  cnic       String?
  address    String?
  isPrimary  Boolean          @default(false) @map("is_primary")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("guardians")
}

model StudentDocument {
  id           String       @id @default(uuid()) @db.Uuid
  studentId    String       @map("student_id") @db.Uuid
  type         DocumentType
  fileName     String       @map("file_name")
  fileUrl      String       @map("file_url")
  uploadedById String?      @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_documents")
}

/// Tracks status/class changes over time (promotions, transfers, suspensions)
model StudentHistory {
  id           String   @id @default(uuid()) @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  event        String
  fromValue    String?  @map("from_value")
  toValue      String?  @map("to_value")
  remarks      String?
  recordedById String?  @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([createdAt])
  @@map("student_history")
}

model StudentEnrollment {
  id             String           @id @default(uuid()) @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  sectionId      String           @map("section_id") @db.Uuid
  academicYearId String           @map("academic_year_id") @db.Uuid
  status         EnrollmentStatus @default(ACTIVE)
  rollNumber     String?          @map("roll_number")
  enrolledAt     DateTime         @default(now()) @map("enrolled_at")
  leftAt         DateTime?        @map("left_at")
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  section        Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([sectionId])
  @@index([academicYearId])
  @@map("student_enrollments")
}

model Teacher {
  id              String                 @id @default(uuid()) @db.Uuid
  employeeCode    String                 @unique @map("employee_code")
  userId          String?                @unique @map("user_id") @db.Uuid
  joiningDate     DateTime               @default(now()) @map("joining_date")
  status          TeacherStatus          @default(ACTIVE)
  firstName       String                 @map("first_name")
  lastName        String                 @map("last_name")
  email           String
  phone           String?
  designation     String?
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  deletedAt       DateTime?              @map("deleted_at")
  createdById     String?                @map("created_by_id") @db.Uuid
  classTeacherOf  ClassTeacher[]
  documents       TeacherDocument[]
  profile         TeacherProfile?
  qualifications  TeacherQualification[]
  teacherSubjects TeacherSubject[]
  user            User?                  @relation(fields: [userId], references: [id])

  @@index([employeeCode])
  @@index([status])
  @@index([lastName, firstName])
  @@index([deletedAt])
  @@map("teachers")
}

model TeacherProfile {
  id                    String      @id @default(uuid()) @db.Uuid
  teacherId             String      @unique @map("teacher_id") @db.Uuid
  dateOfBirth           DateTime?   @map("date_of_birth")
  gender                Gender?
  bloodGroup            BloodGroup? @map("blood_group")
  nationality           String?
  address               String?
  city                  String?
  photoUrl              String?     @map("photo_url")
  cnic                  String?
  experienceYears       Int?        @map("experience_years")
  specialization        String?
  emergencyContactName  String?     @map("emergency_contact_name")
  emergencyContactPhone String?     @map("emergency_contact_phone")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  teacher               Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

model TeacherQualification {
  id            String   @id @default(uuid()) @db.Uuid
  teacherId     String   @map("teacher_id") @db.Uuid
  degreeTitle   String   @map("degree_title")
  institution   String
  yearCompleted Int      @map("year_completed")
  grade         String?
  createdAt     DateTime @default(now()) @map("created_at")
  teacher       Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("teacher_qualifications")
}

model TeacherDocument {
  id           String       @id @default(uuid()) @db.Uuid
  teacherId    String       @map("teacher_id") @db.Uuid
  type         DocumentType
  fileName     String       @map("file_name")
  fileUrl      String       @map("file_url")
  uploadedById String?      @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")
  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("teacher_documents")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  CREATE
  UPDATE
  DELETE
  RESTORE
  PASSWORD_CHANGE
  PASSWORD_RESET
  PERMISSION_CHANGE
  ROLE_CHANGE
  SETTINGS_CHANGE
}

enum ActivityType {
  USER
  ROLE
  PERMISSION
  SETTINGS
  AUTH
  SYSTEM
  STUDENT
  TEACHER
  CLASS
  SUBJECT
  ENROLLMENT
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  SUSPENDED
  EXPELLED
  TRANSFERRED
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  UNKNOWN
}

enum GuardianRelation {
  FATHER
  MOTHER
  BROTHER
  SISTER
  UNCLE
  AUNT
  GRANDFATHER
  GRANDMOTHER
  LEGAL_GUARDIAN
  OTHER
}

enum DocumentType {
  BIRTH_CERTIFICATE
  TRANSFER_CERTIFICATE
  REPORT_CARD
  CNIC_B_FORM
  VACCINATION_RECORD
  PHOTOGRAPH
  DEGREE
  CNIC
  RESUME
  CONTRACT
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
  TRANSFERRED
}
