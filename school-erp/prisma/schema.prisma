// ============================================================================
// School ERP - Foundation Layer - Prisma Schema
// PostgreSQL | UUID PKs | Soft Deletes | Audit Timestamps | Optimized Indexes
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  CREATE
  UPDATE
  DELETE
  RESTORE
  PASSWORD_CHANGE
  PASSWORD_RESET
  PERMISSION_CHANGE
  ROLE_CHANGE
  SETTINGS_CHANGE
}

enum ActivityType {
  USER
  ROLE
  PERMISSION
  SETTINGS
  AUTH
  SYSTEM
  STUDENT
  TEACHER
  CLASS
  SUBJECT
  ENROLLMENT
  ATTENDANCE
  EXAM
  RESULT
  FEE
  PAYMENT
  SCHOLARSHIP
  PAYROLL
  LIBRARY
  TRANSPORT
  INVENTORY
  MESSAGE
  ANNOUNCEMENT
  TIMETABLE
  ASSIGNMENT
  EVENT
}

// ----------------------------------------------------------------------------
// PART 2 ENUMS — Academic Management Layer
// ----------------------------------------------------------------------------

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  SUSPENDED
  EXPELLED
  TRANSFERRED
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  UNKNOWN
}

enum GuardianRelation {
  FATHER
  MOTHER
  BROTHER
  SISTER
  UNCLE
  AUNT
  GRANDFATHER
  GRANDMOTHER
  LEGAL_GUARDIAN
  OTHER
}

enum DocumentType {
  BIRTH_CERTIFICATE
  TRANSFER_CERTIFICATE
  REPORT_CARD
  CNIC_B_FORM
  VACCINATION_RECORD
  PHOTOGRAPH
  DEGREE
  CNIC
  RESUME
  CONTRACT
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
  TRANSFERRED
}

// ----------------------------------------------------------------------------
// USERS
// ----------------------------------------------------------------------------

model User {
  id                String     @id @default(uuid()) @db.Uuid
  firstName         String     @map("first_name")
  lastName          String     @map("last_name")
  email             String     @unique
  phone             String?
  passwordHash      String     @map("password_hash")
  avatarUrl         String?    @map("avatar_url")
  status            UserStatus @default(PENDING)
  preferredLanguage String     @default("en") @map("preferred_language")
  preferredTheme    String     @default("light") @map("preferred_theme")

  emailVerifiedAt   DateTime?  @map("email_verified_at")
  lastLoginAt       DateTime?  @map("last_login_at")
  lastLoginIp       String?    @map("last_login_ip")

  passwordResetToken   String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")

  // Security hardening: brute-force lockout, stale-token invalidation, forced password change
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  tokenVersion        Int       @default(0) @map("token_version")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")

  rememberToken     String?    @map("remember_token")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[] @relation("UserCreatedBy")

  userRoles     UserRole[]
  auditLogs     AuditLog[]
  activityLogs  ActivityLog[]

  // Part 2: a login account may represent a teacher or a student (portal access)
  teacherProfile Teacher?
  studentProfile Student?
  employeeProfile Employee?

  // Part 3: attendance records marked by this user (typically a teacher)
  markedAttendance Attendance[]

  // Part 4A: fee payments collected by this user (typically an accountant)
  collectedPayments FeePayment[]

  // Part 5: internal messaging & announcements
  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  announcements    Announcement[] @relation("PublishedAnnouncements")
  createdEvents    Event[]        @relation("CreatedEvents")
  guardianOf       Guardian[]     @relation("GuardianAccounts")
  sessions         UserSession[]

  @@index([email])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

// ----------------------------------------------------------------------------
// ROLES & PERMISSIONS (RBAC)
// ----------------------------------------------------------------------------

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  slug        String  @unique
  description String?
  isSystem    Boolean @default(false) @map("is_system") // built-in roles cannot be deleted

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([slug])
  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique // e.g. "users.create"
  module      String // e.g. "users"
  action      String // e.g. "create"
  description String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@index([name])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ----------------------------------------------------------------------------
// AUDIT & ACTIVITY LOGS
// ----------------------------------------------------------------------------

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  action     AuditAction
  entityType String?     @map("entity_type") // e.g. "User", "Role"
  entityId   String?     @map("entity_id") @db.Uuid
  oldValues  Json?       @map("old_values")
  newValues  Json?       @map("new_values")
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ActivityLog {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String?      @map("user_id") @db.Uuid
  type        ActivityType
  description String
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("activity_logs")
}

// ----------------------------------------------------------------------------
// SETTINGS & LANGUAGES
// ----------------------------------------------------------------------------

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  group     String   @default("general") // "school" | "system"
  type      String   @default("string")  // string | number | boolean | json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([group])
  @@map("settings")
}

model Language {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique // "en" | "ur"
  name      String // "English" | "Urdu"
  nativeName String  @map("native_name") // "English" | "اردو"
  direction String   @default("ltr") // "ltr" | "rtl"
  isActive  Boolean  @default(true) @map("is_active")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("languages")
}

// ============================================================================
// PART 2 — CORE ACADEMIC MANAGEMENT LAYER
// ============================================================================

// ----------------------------------------------------------------------------
// ACADEMIC YEAR / CLASS / SECTION
// ----------------------------------------------------------------------------

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique // e.g. "2025-2026"
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isCurrent Boolean  @default(false) @map("is_current")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  classes      Class[]
  enrollments  StudentEnrollment[]
  exams        Exam[]
  feeStructures FeeStructure[]

  @@index([isCurrent])
  @@map("academic_years")
}

model Class {
  id          String  @id @default(uuid()) @db.Uuid
  name        String // "Grade 1", "Grade 10"
  numericGrade Int    @map("numeric_grade") // 1..12 for sorting
  academicYearId String @map("academic_year_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  sections     Section[]
  classSubjects ClassSubject[]
  attendanceRecords Attendance[]
  exams        Exam[]
  feeStructures FeeStructure[]

  @@unique([name, academicYearId])
  @@index([academicYearId])
  @@map("classes")
}

model Section {
  id      String @id @default(uuid()) @db.Uuid
  name    String // "A", "B", "C"
  classId String @map("class_id") @db.Uuid
  capacity Int   @default(40)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  class        Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  classTeacher ClassTeacher?
  enrollments  StudentEnrollment[]
  attendanceRecords Attendance[]
  timetablePeriods TimetablePeriod[]
  assignments  Assignment[]

  @@unique([name, classId])
  @@index([classId])
  @@map("sections")
}

model ClassTeacher {
  id        String @id @default(uuid()) @db.Uuid
  sectionId String @unique @map("section_id") @db.Uuid // one class-teacher per section
  teacherId String @map("teacher_id") @db.Uuid

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@index([teacherId])
  @@map("class_teachers")
}

// ----------------------------------------------------------------------------
// SUBJECT MANAGEMENT
// ----------------------------------------------------------------------------

model Subject {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  code        String  @unique // "MATH101"
  description String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  classSubjects   ClassSubject[]
  teacherSubjects TeacherSubject[]
  attendanceRecords Attendance[]
  examSubjects    ExamSubject[]
  examSchedules   ExamSchedule[]
  timetablePeriods TimetablePeriod[]
  assignments     Assignment[]

  @@index([code])
  @@map("subjects")
}

model ClassSubject {
  id        String @id @default(uuid()) @db.Uuid
  classId   String @map("class_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid
  isElective Boolean @default(false) @map("is_elective")

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  teacherSubjects TeacherSubject[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
  @@map("class_subjects")
}

model TeacherSubject {
  id             String @id @default(uuid()) @db.Uuid
  teacherId      String @map("teacher_id") @db.Uuid
  subjectId      String @map("subject_id") @db.Uuid
  classSubjectId String? @map("class_subject_id") @db.Uuid // optional link to the specific class offering

  teacher      Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classSubject ClassSubject? @relation(fields: [classSubjectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([teacherId, subjectId, classSubjectId])
  @@index([teacherId])
  @@index([subjectId])
  @@map("teacher_subjects")
}

// ----------------------------------------------------------------------------
// STUDENT MANAGEMENT
// ----------------------------------------------------------------------------

model Student {
  id                 String        @id @default(uuid()) @db.Uuid
  registrationNumber String        @unique @map("registration_number") // auto-generated, e.g. STU-2026-00001
  userId             String?       @unique @map("user_id") @db.Uuid // optional portal login
  admissionDate      DateTime      @default(now()) @map("admission_date")
  status             StudentStatus @default(ACTIVE)

  firstName String @map("first_name")
  lastName  String @map("last_name")
  email     String? 
  phone     String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdById String? @map("created_by_id") @db.Uuid

  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  profile        StudentProfile?
  guardians      Guardian[]
  documents      StudentDocument[]
  history        StudentHistory[]
  enrollments    StudentEnrollment[]
  attendanceRecords Attendance[]
  results        StudentResult[]
  studentFees    StudentFee[]
  scholarships   StudentScholarship[]
  bookIssues     BookIssue[]
  transportAssignments StudentTransport[]
  assignmentSubmissions AssignmentSubmission[]

  @@index([registrationNumber])
  @@index([status])
  @@index([lastName, firstName])
  @@index([deletedAt])
  @@map("students")
}

model StudentProfile {
  id        String    @id @default(uuid()) @db.Uuid
  studentId String    @unique @map("student_id") @db.Uuid

  dateOfBirth DateTime? @map("date_of_birth")
  gender      Gender?
  bloodGroup  BloodGroup? @map("blood_group")
  nationality String?
  religion    String?

  address     String?
  city        String?
  photoUrl    String?  @map("photo_url")

  emergencyContactName  String? @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")
  emergencyContactRelation String? @map("emergency_contact_relation")

  previousSchoolName    String?  @map("previous_school_name")
  previousSchoolAddress String?  @map("previous_school_address")
  previousGrade         String?  @map("previous_grade")

  medicalNotes String? @map("medical_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model Guardian {
  id        String           @id @default(uuid()) @db.Uuid
  studentId String           @map("student_id") @db.Uuid
  relation  GuardianRelation
  firstName String           @map("first_name")
  lastName  String           @map("last_name")
  phone     String
  email     String?
  occupation String?
  cnic      String?
  address   String?
  isPrimary Boolean          @default(false) @map("is_primary")

  // Links this guardian record to an actual portal login account (the
  // "parent" role user), so the parent portal can be scoped to only the
  // children actually linked to them instead of every student in the school.
  // Nullable because a guardian can exist purely as contact info before any
  // login account is created for them.
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation("GuardianAccounts", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([userId])
  @@map("guardians")
}

model StudentDocument {
  id         String       @id @default(uuid()) @db.Uuid
  studentId  String       @map("student_id") @db.Uuid
  type       DocumentType
  fileName   String       @map("file_name")
  fileUrl    String       @map("file_url")
  uploadedById String?    @map("uploaded_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_documents")
}

/// Tracks status/class changes over time (promotions, transfers, suspensions)
model StudentHistory {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  event     String // "STATUS_CHANGE" | "PROMOTION" | "TRANSFER" | "NOTE"
  fromValue String?  @map("from_value")
  toValue   String?  @map("to_value")
  remarks   String?
  recordedById String? @map("recorded_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([createdAt])
  @@map("student_history")
}

model StudentEnrollment {
  id             String           @id @default(uuid()) @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  sectionId      String           @map("section_id") @db.Uuid
  academicYearId String           @map("academic_year_id") @db.Uuid
  status         EnrollmentStatus @default(ACTIVE)
  rollNumber     String?          @map("roll_number")
  enrolledAt     DateTime         @default(now()) @map("enrolled_at")
  leftAt         DateTime?        @map("left_at")

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section      Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId]) // one active enrollment per year
  @@index([sectionId])
  @@index([academicYearId])
  @@map("student_enrollments")
}

// ----------------------------------------------------------------------------
// TEACHER MANAGEMENT
// ----------------------------------------------------------------------------

model Teacher {
  id            String        @id @default(uuid()) @db.Uuid
  employeeCode  String        @unique @map("employee_code")
  userId        String?       @unique @map("user_id") @db.Uuid
  joiningDate   DateTime      @default(now()) @map("joining_date")
  status        TeacherStatus @default(ACTIVE)

  firstName   String @map("first_name")
  lastName    String @map("last_name")
  email       String
  phone       String?
  designation String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdById String? @map("created_by_id") @db.Uuid

  user            User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  profile         TeacherProfile?
  qualifications  TeacherQualification[]
  documents       TeacherDocument[]
  classTeacherOf  ClassTeacher[]
  teacherSubjects TeacherSubject[]
  timetablePeriods TimetablePeriod[]
  assignments     Assignment[]

  @@index([employeeCode])
  @@index([status])
  @@index([lastName, firstName])
  @@index([deletedAt])
  @@map("teachers")
}

model TeacherProfile {
  id        String    @id @default(uuid()) @db.Uuid
  teacherId String    @unique @map("teacher_id") @db.Uuid

  dateOfBirth DateTime?   @map("date_of_birth")
  gender      Gender?
  bloodGroup  BloodGroup? @map("blood_group")
  nationality String?
  address     String?
  city        String?
  photoUrl    String?     @map("photo_url")
  cnic        String?

  experienceYears Int?    @map("experience_years")
  specialization  String?

  emergencyContactName  String? @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

model TeacherQualification {
  id          String  @id @default(uuid()) @db.Uuid
  teacherId   String  @map("teacher_id") @db.Uuid
  degreeTitle String  @map("degree_title") // "M.Ed", "BSc Mathematics"
  institution String
  yearCompleted Int   @map("year_completed")
  grade       String?

  createdAt DateTime @default(now()) @map("created_at")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("teacher_qualifications")
}

model TeacherDocument {
  id         String       @id @default(uuid()) @db.Uuid
  teacherId  String       @map("teacher_id") @db.Uuid
  type       DocumentType
  fileName   String       @map("file_name")
  fileUrl    String       @map("file_url")
  uploadedById String?    @map("uploaded_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("teacher_documents")
}

// ============================================================================
// PART 3 — ATTENDANCE + EXAMINATION + RESULTS MANAGEMENT LAYER
// ============================================================================

// ----------------------------------------------------------------------------
// PART 3 ENUMS
// ----------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  LATE
}

enum ExamType {
  QUIZ
  MID_TERM
  FINAL_TERM
  MONTHLY_TEST
  ASSIGNMENT
  OTHER
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  ONGOING
  COMPLETED
  RESULT_PUBLISHED
  CANCELLED
}

enum ResultStatus {
  DRAFT
  PUBLISHED
}

// ----------------------------------------------------------------------------
// ATTENDANCE MANAGEMENT
// ----------------------------------------------------------------------------

model Attendance {
  id        String           @id @default(uuid()) @db.Uuid
  studentId String           @map("student_id") @db.Uuid
  classId   String           @map("class_id") @db.Uuid
  sectionId String           @map("section_id") @db.Uuid
  subjectId String?          @map("subject_id") @db.Uuid // null = whole-day attendance; set = subject-wise
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  remarks   String?
  markedById String?         @map("marked_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  markedBy User?   @relation(fields: [markedById], references: [id], onDelete: SetNull)

  // One attendance record per student per day for whole-day marking,
  // and per student/day/subject for subject-wise marking.
  @@unique([studentId, date, subjectId])
  @@index([classId, sectionId, date])
  @@index([studentId])
  @@index([date])
  @@map("attendance")
}

model AttendanceRule {
  id                          String   @id @default(uuid()) @db.Uuid
  name                        String   @default("Default Attendance Rule")
  minimumAttendancePercentage Decimal  @default(75) @map("minimum_attendance_percentage") @db.Decimal(5, 2)
  isActive                    Boolean  @default(true) @map("is_active")
  settings                    Json?    // reserved for future rule-engine config (grace days, holiday calendar, etc.)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("attendance_rules")
}

// ----------------------------------------------------------------------------
// EXAMINATION MANAGEMENT
// ----------------------------------------------------------------------------

model Exam {
  id             String     @id @default(uuid()) @db.Uuid
  name           String // "Mid Term Examination 2026"
  type           ExamType
  academicYearId String     @map("academic_year_id") @db.Uuid
  classId        String     @map("class_id") @db.Uuid
  startDate      DateTime   @map("start_date")
  endDate        DateTime   @map("end_date")
  status         ExamStatus @default(DRAFT)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdById String? @map("created_by_id") @db.Uuid

  academicYear AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  examSubjects ExamSubject[]
  schedules    ExamSchedule[]
  results      StudentResult[]

  @@index([academicYearId])
  @@index([classId])
  @@index([status])
  @@map("exams")
}

model ExamSubject {
  id            String  @id @default(uuid()) @db.Uuid
  examId        String  @map("exam_id") @db.Uuid
  subjectId     String  @map("subject_id") @db.Uuid
  totalMarks    Int     @default(100) @map("total_marks")
  passingMarks  Int     @default(40) @map("passing_marks")

  createdAt DateTime @default(now()) @map("created_at")

  exam         Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject      Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  schedule     ExamSchedule?
  subjectMarks SubjectMarks[]

  @@unique([examId, subjectId])
  @@index([examId])
  @@index([subjectId])
  @@map("exam_subjects")
}

model ExamSchedule {
  id            String   @id @default(uuid()) @db.Uuid
  examId        String   @map("exam_id") @db.Uuid
  examSubjectId String   @unique @map("exam_subject_id") @db.Uuid // one schedule slot per exam-subject
  subjectId     String   @map("subject_id") @db.Uuid
  examDate      DateTime @map("exam_date") @db.Date
  startTime     String   @map("start_time") // "09:00"
  endTime       String   @map("end_time")   // "11:00"
  room          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  exam        Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([examDate])
  @@map("exam_schedules")
}

// ----------------------------------------------------------------------------
// RESULT MANAGEMENT
// ----------------------------------------------------------------------------

model StudentResult {
  id             String       @id @default(uuid()) @db.Uuid
  studentId      String       @map("student_id") @db.Uuid
  examId         String       @map("exam_id") @db.Uuid
  totalMarks     Int          @map("total_marks")
  obtainedMarks  Decimal      @map("obtained_marks") @db.Decimal(7, 2)
  percentage     Decimal      @db.Decimal(5, 2)
  grade          String
  gpa            Decimal?     @db.Decimal(3, 2)
  position       Int? // rank within class/section for this exam
  status         ResultStatus @default(DRAFT)
  remarks        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  computedById String? @map("computed_by_id") @db.Uuid
  publishedAt  DateTime? @map("published_at")

  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam         Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectMarks SubjectMarks[]

  @@unique([studentId, examId])
  @@index([examId])
  @@index([studentId])
  @@index([status])
  @@map("student_results")
}

model SubjectMarks {
  id             String  @id @default(uuid()) @db.Uuid
  resultId       String  @map("result_id") @db.Uuid
  examSubjectId  String  @map("exam_subject_id") @db.Uuid
  obtainedMarks  Decimal @map("obtained_marks") @db.Decimal(6, 2)
  grade          String
  isAbsent       Boolean @default(false) @map("is_absent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  result      StudentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  examSubject ExamSubject   @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)

  @@unique([resultId, examSubjectId])
  @@index([resultId])
  @@index([examSubjectId])
  @@map("subject_marks")
}

// ============================================================================
// PART 4A — FEES & FINANCE MANAGEMENT MODULE
// ============================================================================

// ----------------------------------------------------------------------------
// PART 4A ENUMS
// ----------------------------------------------------------------------------

enum FeeStatus {
  ACTIVE
  INACTIVE
}

enum StudentFeeStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  ONLINE
  OTHER
}

enum ScholarshipType {
  PERCENTAGE
  FIXED
}

// ----------------------------------------------------------------------------
// FEE STRUCTURE MANAGEMENT
// ----------------------------------------------------------------------------

model FeeCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique // "Tuition Fee", "Admission Fee", "Library Fee"...
  description String?
  status      FeeStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  feeStructures FeeStructure[]

  @@index([status])
  @@map("fee_categories")
}

model FeeStructure {
  id             String    @id @default(uuid()) @db.Uuid
  classId        String    @map("class_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  feeCategoryId  String    @map("fee_category_id") @db.Uuid
  amount         Decimal   @db.Decimal(10, 2)
  dueDate        DateTime  @map("due_date")
  status         FeeStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdById String? @map("created_by_id") @db.Uuid

  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  feeCategory  FeeCategory  @relation(fields: [feeCategoryId], references: [id], onDelete: Cascade)
  studentFees  StudentFee[]

  @@unique([classId, academicYearId, feeCategoryId])
  @@index([classId])
  @@index([academicYearId])
  @@index([feeCategoryId])
  @@map("fee_structures")
}

// ----------------------------------------------------------------------------
// STUDENT FEE ASSIGNMENT
// ----------------------------------------------------------------------------

model StudentFee {
  id             String           @id @default(uuid()) @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  feeStructureId String           @map("fee_structure_id") @db.Uuid
  amount         Decimal          @db.Decimal(10, 2) // snapshot of FeeStructure.amount at assignment time
  discount       Decimal          @default(0) @db.Decimal(10, 2)
  finalAmount    Decimal          @map("final_amount") @db.Decimal(10, 2) // amount - discount
  dueDate        DateTime         @map("due_date")
  status         StudentFeeStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignedById String? @map("assigned_by_id") @db.Uuid

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  payments     FeePayment[]

  @@unique([studentId, feeStructureId])
  @@index([studentId])
  @@index([feeStructureId])
  @@index([status])
  @@index([dueDate])
  @@map("student_fees")
}

// ----------------------------------------------------------------------------
// FEE COLLECTION
// ----------------------------------------------------------------------------

model FeePayment {
  id              String        @id @default(uuid()) @db.Uuid
  studentFeeId    String        @map("student_fee_id") @db.Uuid
  receiptNumber   String        @unique @map("receipt_number") // auto-generated, e.g. RCPT-2026-00001
  amountPaid      Decimal       @map("amount_paid") @db.Decimal(10, 2)
  paymentDate     DateTime      @default(now()) @map("payment_date")
  paymentMethod   PaymentMethod @default(CASH) @map("payment_method")
  referenceNumber String?       @map("reference_number") // cheque no. / transaction id
  remarks         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  collectedById String? @map("collected_by_id") @db.Uuid

  studentFee  StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  collectedBy User?      @relation(fields: [collectedById], references: [id], onDelete: SetNull)

  @@index([studentFeeId])
  @@index([paymentDate])
  @@index([receiptNumber])
  @@map("fee_payments")
}

// ----------------------------------------------------------------------------
// FEE DISCOUNTS & SCHOLARSHIPS
// ----------------------------------------------------------------------------

model Scholarship {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  type        ScholarshipType
  value       Decimal         @db.Decimal(10, 2) // percentage (0-100) or fixed amount, per `type`
  description String?
  status      FeeStatus       @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  studentScholarships StudentScholarship[]

  @@index([status])
  @@map("scholarships")
}

model StudentScholarship {
  id            String   @id @default(uuid()) @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  scholarshipId String   @map("scholarship_id") @db.Uuid
  assignedDate  DateTime @default(now()) @map("assigned_date")
  assignedById  String?  @map("assigned_by_id") @db.Uuid

  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([studentId, scholarshipId])
  @@index([studentId])
  @@index([scholarshipId])
  @@map("student_scholarships")
}

// ============================================================================
// PART 4B — MODULE 1: HR & STAFF MANAGEMENT
// ============================================================================

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
}

model Department {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  designations Designation[]
  employees    Employee[]

  @@map("departments")
}

model Designation {
  id           String  @id @default(uuid()) @db.Uuid
  departmentId String  @map("department_id") @db.Uuid
  title        String
  description  String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employees  Employee[]

  @@unique([departmentId, title])
  @@index([departmentId])
  @@map("designations")
}

model Employee {
  id               String         @id @default(uuid()) @db.Uuid
  employeeCode     String         @unique @map("employee_code") // e.g. EMP-2026-00001
  userId           String?        @unique @map("user_id") @db.Uuid // optional portal login
  departmentId     String         @map("department_id") @db.Uuid
  designationId    String         @map("designation_id") @db.Uuid
  joiningDate      DateTime       @default(now()) @map("joining_date")
  salary           Decimal        @db.Decimal(10, 2)
  phone            String?
  address          String?
  emergencyContact String?        @map("emergency_contact")
  status           EmployeeStatus @default(ACTIVE)

  firstName String @map("first_name")
  lastName  String @map("last_name")
  email     String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdById String? @map("created_by_id") @db.Uuid

  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  department  Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designation Designation         @relation(fields: [designationId], references: [id], onDelete: Restrict)
  documents   EmployeeDocument[]
  salaryStructure SalaryStructure?
  payrolls    Payroll[]

  @@index([employeeCode])
  @@index([departmentId])
  @@index([designationId])
  @@index([status])
  @@index([deletedAt])
  @@map("employees")
}

model EmployeeDocument {
  id           String       @id @default(uuid()) @db.Uuid
  employeeId   String       @map("employee_id") @db.Uuid
  documentType DocumentType @map("document_type")
  fileName     String       @map("file_name")
  fileUrl      String       @map("file_url")
  uploadedById String?      @map("uploaded_by_id") @db.Uuid

  uploadedAt DateTime @default(now()) @map("uploaded_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_documents")
}

// ============================================================================
// PART 4B — MODULE 2: PAYROLL MANAGEMENT
// ============================================================================

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model SalaryStructure {
  id          String  @id @default(uuid()) @db.Uuid
  employeeId  String  @unique @map("employee_id") @db.Uuid
  basicSalary Decimal @map("basic_salary") @db.Decimal(10, 2)
  allowances  Decimal @default(0) @db.Decimal(10, 2) // flat monthly allowances (housing, medical, etc.)
  deductions  Decimal @default(0) @db.Decimal(10, 2) // flat monthly deductions (tax, insurance, etc.)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("salary_structures")
}

model Payroll {
  id           String        @id @default(uuid()) @db.Uuid
  employeeId   String        @map("employee_id") @db.Uuid
  month        Int // 1-12
  year         Int
  basicSalary  Decimal       @map("basic_salary") @db.Decimal(10, 2)
  allowances   Decimal       @default(0) @db.Decimal(10, 2)
  bonus        Decimal       @default(0) @db.Decimal(10, 2)
  deductions   Decimal       @default(0) @db.Decimal(10, 2)
  grossSalary  Decimal       @map("gross_salary") @db.Decimal(10, 2) // basic + allowances + bonus
  netSalary    Decimal       @map("net_salary") @db.Decimal(10, 2)   // gross - deductions
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  paymentDate  DateTime?     @map("payment_date")
  remarks      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  generatedById String? @map("generated_by_id") @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([month, year])
  @@index([paymentStatus])
  @@map("payrolls")
}

// ============================================================================
// PART 4B — MODULE 3: LIBRARY MANAGEMENT
// ============================================================================

enum BookIssueStatus {
  ISSUED
  RETURNED
  OVERDUE
  LOST
}

model BookCategory {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  books Book[]

  @@map("book_categories")
}

model Book {
  id                String  @id @default(uuid()) @db.Uuid
  categoryId        String  @map("category_id") @db.Uuid
  title             String
  author            String
  isbn              String? @unique
  publisher         String?
  quantity          Int     @default(1)
  availableQuantity Int     @map("available_quantity")
  shelfLocation     String? @map("shelf_location")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdById String? @map("created_by_id") @db.Uuid

  category BookCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  issues   BookIssue[]

  @@index([categoryId])
  @@index([title])
  @@index([isbn])
  @@map("books")
}

model BookIssue {
  id         String          @id @default(uuid()) @db.Uuid
  bookId     String          @map("book_id") @db.Uuid
  studentId  String          @map("student_id") @db.Uuid
  issueDate  DateTime        @default(now()) @map("issue_date")
  dueDate    DateTime        @map("due_date")
  returnDate DateTime?       @map("return_date")
  fineAmount Decimal         @default(0) @map("fine_amount") @db.Decimal(8, 2)
  finePaid   Boolean         @default(false) @map("fine_paid")
  status     BookIssueStatus @default(ISSUED)
  remarks    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  issuedById   String? @map("issued_by_id") @db.Uuid
  returnedById String? @map("returned_by_id") @db.Uuid

  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([studentId])
  @@index([status])
  @@index([dueDate])
  @@map("book_issues")
}

// ============================================================================
// PART 4B — MODULE 4: TRANSPORT MANAGEMENT
// ============================================================================

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum DriverStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum TransportAssignmentStatus {
  ACTIVE
  INACTIVE
}

model Vehicle {
  id            String        @id @default(uuid()) @db.Uuid
  vehicleNumber String        @unique @map("vehicle_number") // e.g. "LEA-4521"
  model         String?
  capacity      Int
  status        VehicleStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  routes Route[]

  @@index([status])
  @@map("vehicles")
}

model Driver {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  phone         String
  licenseNumber String       @unique @map("license_number")
  status        DriverStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  routes Route[]

  @@index([status])
  @@map("drivers")
}

model Route {
  id          String  @id @default(uuid()) @db.Uuid
  routeName   String  @map("route_name")
  startPoint  String  @map("start_point")
  endPoint    String  @map("end_point")
  monthlyFee  Decimal @map("monthly_fee") @db.Decimal(10, 2)
  vehicleId   String? @map("vehicle_id") @db.Uuid
  driverId    String? @map("driver_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  vehicle          Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver           Driver?            @relation(fields: [driverId], references: [id], onDelete: SetNull)
  studentTransports StudentTransport[]

  @@index([vehicleId])
  @@index([driverId])
  @@map("routes")
}

model StudentTransport {
  id           String                    @id @default(uuid()) @db.Uuid
  studentId    String                    @map("student_id") @db.Uuid
  routeId      String                    @map("route_id") @db.Uuid
  assignedDate DateTime                  @default(now()) @map("assigned_date")
  status       TransportAssignmentStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignedById String? @map("assigned_by_id") @db.Uuid

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([studentId, routeId])
  @@index([studentId])
  @@index([routeId])
  @@index([status])
  @@map("student_transports")
}

// ============================================================================
// PART 5 — MODULE 5: INVENTORY MANAGEMENT
// ============================================================================

enum InventoryUnit {
  PCS
  BOX
  PACKET
  KG
  LITRE
  SET
  REAM
  OTHER
}

enum InventoryItemStatus {
  ACTIVE
  DISCONTINUED
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

model InventoryCategory {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  items InventoryItem[]

  @@map("inventory_categories")
}

model InventoryItem {
  id           String              @id @default(uuid()) @db.Uuid
  name         String
  sku          String?             @unique
  categoryId   String              @map("category_id") @db.Uuid
  unit         InventoryUnit       @default(PCS)
  quantity     Int                 @default(0)
  reorderLevel Int                 @default(0) @map("reorder_level")
  unitPrice    Decimal             @default(0) @map("unit_price") @db.Decimal(10, 2)
  supplier     String?
  location     String?
  status       InventoryItemStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  category     InventoryCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions InventoryTransaction[]

  @@index([categoryId])
  @@index([status])
  @@index([name])
  @@map("inventory_items")
}

model InventoryTransaction {
  id       String                   @id @default(uuid()) @db.Uuid
  itemId   String                   @map("item_id") @db.Uuid
  type     InventoryTransactionType
  quantity Int
  reason   String?

  createdAt DateTime @default(now()) @map("created_at")

  performedById String? @map("performed_by_id") @db.Uuid

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_transactions")
}

// ============================================================================
// PART 5 — MODULE 6: MESSAGING & ANNOUNCEMENTS
// ============================================================================

enum MessageStatus {
  UNREAD
  READ
}

enum AnnouncementAudience {
  ALL
  STUDENTS
  PARENTS
  TEACHERS
  STAFF
}

model Message {
  id          String        @id @default(uuid()) @db.Uuid
  senderId    String        @map("sender_id") @db.Uuid
  recipientId String        @map("recipient_id") @db.Uuid
  subject     String
  content     String
  status      MessageStatus @default(UNREAD)
  readAt      DateTime?     @map("read_at")

  deletedBySender    Boolean @default(false) @map("deleted_by_sender")
  deletedByRecipient Boolean @default(false) @map("deleted_by_recipient")

  createdAt DateTime @default(now()) @map("created_at")

  sender    User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([status])
  @@index([createdAt])
  @@map("messages")
}

model Announcement {
  id        String               @id @default(uuid()) @db.Uuid
  title     String
  content   String
  audience  AnnouncementAudience @default(ALL)
  isPinned  Boolean              @default(false) @map("is_pinned")
  expiresAt DateTime?            @map("expires_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  publishedById String? @map("published_by_id") @db.Uuid
  publishedBy   User?   @relation("PublishedAnnouncements", fields: [publishedById], references: [id], onDelete: SetNull)

  @@index([audience])
  @@index([isPinned])
  @@index([createdAt])
  @@map("announcements")
}

// ============================================================================
// PART 6 — MODULE 7: TIMETABLE MANAGEMENT
// ============================================================================

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model TimetablePeriod {
  id           String    @id @default(uuid()) @db.Uuid
  sectionId    String    @map("section_id") @db.Uuid
  subjectId    String    @map("subject_id") @db.Uuid
  teacherId    String?   @map("teacher_id") @db.Uuid
  dayOfWeek    DayOfWeek @map("day_of_week")
  periodNumber Int       @map("period_number") // 1, 2, 3...
  startTime    String    @map("start_time") // "08:00"
  endTime      String    @map("end_time") // "08:40"
  roomNumber   String?   @map("room_number")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  section Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([sectionId, dayOfWeek, periodNumber])
  @@index([sectionId])
  @@index([teacherId])
  @@index([dayOfWeek])
  @@map("timetable_periods")
}

// ============================================================================
// PART 7 — MODULE 8: ASSIGNMENTS (HOMEWORK)
// ============================================================================

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
}

model Assignment {
  id            String           @id @default(uuid()) @db.Uuid
  sectionId     String           @map("section_id") @db.Uuid
  subjectId     String           @map("subject_id") @db.Uuid
  teacherId     String?          @map("teacher_id") @db.Uuid
  title         String
  description   String
  attachmentUrl String?          @map("attachment_url")
  maxMarks      Int?             @map("max_marks")
  dueDate       DateTime         @map("due_date")
  status        AssignmentStatus @default(PUBLISHED)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  section     Section                @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject     Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     Teacher?               @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  submissions AssignmentSubmission[]

  @@index([sectionId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([dueDate])
  @@index([status])
  @@map("assignments")
}

model AssignmentSubmission {
  id            String           @id @default(uuid()) @db.Uuid
  assignmentId  String           @map("assignment_id") @db.Uuid
  studentId     String           @map("student_id") @db.Uuid
  content       String?
  attachmentUrl String?          @map("attachment_url")
  status        SubmissionStatus @default(SUBMITTED)
  submittedAt   DateTime         @default(now()) @map("submitted_at")

  marksObtained Int?      @map("marks_obtained")
  feedback      String?
  gradedAt      DateTime? @map("graded_at")
  gradedById    String?   @map("graded_by_id") @db.Uuid

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
  @@map("assignment_submissions")
}

// ============================================================================
// PART 8 — MODULE 9: EVENTS & CALENDAR
// ============================================================================

enum EventType {
  HOLIDAY
  EXAM
  MEETING
  FUNCTION
  SPORTS
  OTHER
}

model Event {
  id          String               @id @default(uuid()) @db.Uuid
  title       String
  description String?
  type        EventType            @default(OTHER)
  audience    AnnouncementAudience @default(ALL)
  startDate   DateTime             @map("start_date")
  endDate     DateTime             @map("end_date")
  isAllDay    Boolean              @default(true) @map("is_all_day")
  startTime   String?              @map("start_time") // "09:00" when isAllDay is false
  endTime     String?              @map("end_time")
  location    String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("CreatedEvents", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([startDate])
  @@index([endDate])
  @@index([type])
  @@index([audience])
  @@map("events")
}

// ============================================================================
// PART 9 — SESSION MANAGEMENT (per-device visibility & revocation)
// ============================================================================

model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenId    String    @unique @map("token_id") // matches the `jti` claim of the current refresh token for this device
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  expiresAt  DateTime  @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenId])
  @@map("user_sessions")
}
